# Copy this file to .env (same folder as main.py / api_server.py) and fill in real values.
# .env should never be committed — add it to .gitignore if you haven't already.

# --- MongoDB Atlas ---
# Get this from Atlas: Database > Connect > Drivers > copy the connection string,
# then replace <password> with your actual database user password.
# Example: mongodb+srv://wavelength_user:REALPASSWORD@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Optional — database name inside your Atlas cluster. Defaults to "wavelength" if omitted.
MONGODB_DB=wavelength

# --- Auth ---
# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# --- Whatever main.py's own pipeline already needs (LLM API keys, etc.) ---
# keep those in this same .env file too — main.py already calls load_dotenv()
